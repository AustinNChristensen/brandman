# Deployment configuration only. Populate values using the provider's secret
# manager; never commit a real credential or database URL.
BRAND_OS_DB=/var/lib/brand-os/brand_os.db
BRAND_OS_DATABASE_PROFILE=operating
BRAND_OS_PREVIEW_PASSWORD=replace-with-a-secret-manager-reference
BRAND_OS_CREDENTIAL_MASTER_KEY=replace-with-a-secret-manager-reference
BRAND_OS_ALLOWED_HOSTS=brandman.example.com
BRAND_OS_REQUIRE_HTTPS=true
