# BrandMan configuration. `brandman init` writes a local .env for you.
# In production, set these through your host's secret manager; never commit a
# real credential or database file.
# Canonical names are BRANDMAN_*. Deprecated BRAND_OS_* names still work and warn.

# Required
BRANDMAN_DB=/var/lib/brandman/brandman.db
# operating | development | test | proof
BRANDMAN_DATABASE_PROFILE=operating
# The example value is rejected. Use a real secret (16+ characters off loopback).
BRANDMAN_PREVIEW_PASSWORD=replace-with-a-secret-manager-reference

# Remote access. Leave these commented for loopback Compose and `brandman serve`.
# A copied file that sets REQUIRE_HTTPS refuses http://localhost.
# BRANDMAN_ALLOWED_HOSTS=brandman.example.com
# BRANDMAN_REQUIRE_HTTPS=true

# Optional
# Fernet key for stored connector credentials
BRANDMAN_CREDENTIAL_MASTER_KEY=replace-with-a-secret-manager-reference
# demo | none | path/to/pack.json
BRANDMAN_SEED_PACK=demo
# address shown as a mailto: access-request link on the login page (omit for no link)
# BRANDMAN_ACCESS_REQUEST_EMAIL=access@example.com
# principal recorded on approvals
BRANDMAN_OPERATOR=operator
# HTTP Basic user name for the password gate
BRANDMAN_BASIC_USER=operator
# units that mark a volatile numeric claim
# BRANDMAN_CLAIM_UNITS=credits,seats,users
# true when one process serves several databases
# BRANDMAN_MCP_STATELESS=false
# BRANDMAN_DISABLE_PLUGINS=false
# BRANDMAN_WORKER_MAX_JOBS=100
# BRANDMAN_SCHEDULER_MAX_DECISIONS=50
# Personal bearer token for scripts and self-hosted /mcp. brandman init generates one.
# Short and example values are ignored. Not a BrandMan Cloud workspace token.
# BRANDMAN_API_TOKEN=
# Optional built-in drafting. The core install has no model SDK.
# Install brandman[anthropic], brandman[openai], or brandman[drafting].
# BRANDMAN_DRAFT_PROVIDER=none
# BRANDMAN_DRAFT_MODEL=
# OpenAI-compatible base URL: https://api.x.ai/v1, https://openrouter.ai/api/v1,
# http://127.0.0.1:11434/v1 (Ollama), or a vLLM server on its own port.
# BRANDMAN_DRAFT_BASE_URL=
# BRANDMAN_DRAFT_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
