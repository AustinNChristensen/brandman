# BrandMan configuration. `brandman init` writes a local .env for you.
# In production, set these through your host's secret manager; never commit a
# real credential or database file. (Older BRAND_OS_* names are still accepted.)

# Required
BRANDMAN_DB=/var/lib/brandman/brandman.db
# operating | development | test | proof
BRANDMAN_DATABASE_PROFILE=operating
BRANDMAN_PREVIEW_PASSWORD=replace-with-a-secret-manager-reference

# Remote access (required when not bound to loopback)
BRANDMAN_ALLOWED_HOSTS=brandman.example.com
BRANDMAN_REQUIRE_HTTPS=true

# Optional
# Fernet key for stored connector credentials
BRANDMAN_CREDENTIAL_MASTER_KEY=replace-with-a-secret-manager-reference
# demo | none | path/to/pack.json
BRANDMAN_SEED_PACK=demo
# principal recorded on approvals
BRANDMAN_OPERATOR=operator
# HTTP Basic user name for the password gate
BRANDMAN_BASIC_USER=operator
# units that mark a volatile numeric claim
# BRANDMAN_CLAIM_UNITS=credits,seats,users
# true when one process serves several databases
# BRANDMAN_MCP_STATELESS=false
# BRANDMAN_DISABLE_PLUGINS=false
# BRANDMAN_WORKER_MAX_JOBS=100
# BRANDMAN_SCHEDULER_MAX_DECISIONS=50
# optional built-in drafting (brandman[anthropic])
# BRANDMAN_DRAFT_MODEL=claude-opus-5-5
# only for optional built-in drafting
# ANTHROPIC_API_KEY=
